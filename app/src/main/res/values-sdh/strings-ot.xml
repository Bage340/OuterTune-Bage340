    <string name="dl_rescan_confirm">ئێستا هەموو فۆڵدەرەکانی دابەزاندن سکان بکەنەوە؟ ئەمەش دەتوانێت چەند خولەکێک بخایەنێت بەپێی قەبارەی کتێبخانەکەت.</string>
    <string name="dl_size_used_cache">ناوخۆیی: %s بەکارهاتووە</string>
    <string name="dl_size_used_main">دەرەکی: %s بەکارهاتووە</string>
